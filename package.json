{
  "name": "hologram-defender",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "predev": "npm run prepare:worker",
    "prebuild": "npm run prepare:worker",
    "prepare:worker": "node scripts/prepare-worker.mjs",
    "dev": "concurrently -n GAME,API \"vite --host 0.0.0.0\" \"tsx server/src/index.ts\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "tsx server/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/src/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prepare:tracking": "node scripts/prepare-tracking.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.3",
    "@fastify/static": "^10.1.4",
    "@mediapipe/tasks-vision": "0.10.32",
    "argon2": "^0.45.1",
    "fastify": "^5.6.2",
    "pixi.js": "^8.14.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
